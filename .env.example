# PostgreSQL
POLYMARKET_DISCOVERY_POSTGRES_DB=polymarket_market_discovery
POLYMARKET_DISCOVERY_POSTGRES_USER=polymarket_market_discovery
POLYMARKET_DISCOVERY_POSTGRES_PASSWORD=polymarket_market_discovery
POLYMARKET_DISCOVERY_POSTGRES_HOST=localhost
POLYMARKET_DISCOVERY_POSTGRES_PORT=5432

# Logging
POLYMARKET_DISCOVERY_LOG_LEVEL=INFO

# Polymarket Data API
POLYMARKET_DATA_API_BASE_URL=https://data-api.polymarket.com
POLYMARKET_DATA_API_MAX_CONCURRENT_REQUESTS=4
POLYMARKET_DATA_API_TIMEOUT_SECONDS=10
POLYMARKET_DATA_API_RATE_LIMIT_RETRY_ATTEMPTS=5
POLYMARKET_DATA_API_RATE_LIMIT_BACKOFF_SECONDS=60
POLYMARKET_POSITIONS_REQUESTS_PER_SECOND=8
POLYMARKET_LEADERBOARD_REQUESTS_PER_SECOND=3

# Polymarket Gamma API
POLYMARKET_GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_GAMMA_API_TIMEOUT_SECONDS=10
POLYMARKET_GAMMA_API_RATE_LIMIT_RETRY_ATTEMPTS=5
POLYMARKET_GAMMA_API_RATE_LIMIT_BACKOFF_SECONDS=10
POLYMARKET_GAMMA_API_REQUESTS_PER_SECOND=5

# Polymarket CLOB API
POLYMARKET_CLOB_API_BASE_URL=https://clob.polymarket.com
POLYMARKET_CLOB_API_TIMEOUT_SECONDS=10
POLYMARKET_CLOB_API_RATE_LIMIT_RETRY_ATTEMPTS=5
POLYMARKET_CLOB_API_RATE_LIMIT_BACKOFF_SECONDS=10
POLYMARKET_ORDERBOOK_REQUESTS_PER_SECOND=5

# pgEdge Postgres MCP
MCP_SERVER_PORT=8080
PGEDGE_AUTH_ENABLED=true
PGEDGE_DB_USER=
PGEDGE_DB_PASSWORD=
# Set a secret token before using the authenticated MCP endpoint.
PGEDGE_MCP_TOKEN=
